# =============================================================================
# Buddy Bet — Environment Variable Reference
# Copy this file to .env and fill in real values. Never commit .env to VCS.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_DEBUG=true                       # Set false in production
APP_HOST=0.0.0.0
APP_PORT=8000

# -----------------------------------------------------------------------------
# Database — PostgreSQL (asyncpg driver)
# The application constructs the full DSN from the components below.
# DSN format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buddy_bet
DB_USER=buddy_bet_app
DB_PASSWORD=change_me_in_production

# Optional: provide a full DSN to override the constructed one (useful in PaaS)
# DATABASE_URL=postgresql+asyncpg://buddy_bet_app:password@localhost:5432/buddy_bet

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Security — JWT
# Generate a strong secret: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Platform — financial constants
# These match the bootstrap data in schema.sql. Do not change after go-live
# unless the platform account is intentionally migrated.
# -----------------------------------------------------------------------------
PLATFORM_ACCOUNT_CODE=PLATFORM_FEES_ZAR
PLATFORM_CURRENCY=ZAR

# Minimum and maximum stake amounts in platform currency
MIN_STAKE_AMOUNT=10.00
MAX_STAKE_AMOUNT=10000.00

# Minutes before kickoff after which bet creation is blocked.
# PO-05: confirm with Product Owner. Default 15 minutes.
BET_CREATION_CUTOFF_MINUTES=15

# -----------------------------------------------------------------------------
# Sports data provider — match ingestion (API-Football / api-sports.io)
# Docs: https://www.api-football.com/documentation-v3
# -----------------------------------------------------------------------------

# Set to true to enable the provider sync endpoints and CLI script.
# Requires SPORTS_PROVIDER_API_KEY to be set.
SPORTS_PROVIDER_ENABLED=false

# API key from api-sports.io (free tier: 100 req/day; paid tiers available).
# Sign up at https://dashboard.api-football.com/
SPORTS_PROVIDER_API_KEY=

# Base URL for API-Football v3 (do not change unless using a mirror/proxy).
SPORTS_PROVIDER_BASE_URL=https://v3.football.api-sports.io

# Comma-separated league IDs to sync. Defaults cover the top 6 European leagues.
# 39=Premier League, 140=La Liga, 78=Bundesliga, 135=Serie A, 61=Ligue 1, 2=Champions League
SPORTS_PROVIDER_LEAGUE_IDS=39,140,78,135,61,2

# How many days ahead to pull upcoming fixtures (default 7).
SPORTS_PROVIDER_SYNC_DAYS_AHEAD=7

# How many days back to pull completed results (default 2).
SPORTS_PROVIDER_SYNC_DAYS_BACK=2

# HTTP timeout in seconds for provider API calls (default 30).
SPORTS_PROVIDER_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR | CRITICAL
