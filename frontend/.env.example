# =============================================================================
# Buddy Bet — Frontend Environment Variables
# Copy this file to .env (development) or set these in your CI/CD pipeline.
# Never commit a .env file containing real credentials.
# =============================================================================

# Base URL of the backend API, WITHOUT a trailing slash.
#
# Development (default):
#   Leave as http://localhost:8000 to reach the local backend directly.
#   The Vite dev proxy (/api → backend) also uses this value, so you only
#   need one variable for both.
#
# Staging / production:
#   Set to the deployed API origin, e.g. https://api.buddybet.co.za
#   The built bundle will call that URL from the browser; ensure CORS is
#   configured on the backend to allow the frontend origin.
#
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Deployment prerequisites (staging / production checklist)
# =============================================================================
#
# 1. Build the frontend:
#      VITE_API_BASE_URL=https://api.example.com npm run build
#    Output lands in frontend/dist/ — serve it from any static host
#    (Nginx, Vercel, Netlify, S3+CloudFront, etc.).
#
# 2. Backend CORS:
#    Add the frontend origin to CORS_ORIGINS in the backend .env so the
#    browser is allowed to make cross-origin requests.
#
# 3. HTTPS:
#    Both the frontend host and the API must be served over HTTPS in
#    production to avoid mixed-content browser errors.
#
# 4. SPA routing:
#    Configure your static host to rewrite all 404s to index.html so
#    React Router can handle client-side navigation correctly.
#    Nginx example:  try_files $uri $uri/ /index.html;
#
# 5. Environment injection:
#    All VITE_* variables are baked into the bundle at build time.
#    There is no runtime configuration — rebuild when the API URL changes.
